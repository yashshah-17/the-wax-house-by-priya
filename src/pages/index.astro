---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
const gallery = [
  {
    title: "Threading",
    category: "FACE",
    image: "https://images.unsplash.com/photo-1733145820348-042a1ae7682a",
  },
  {
    title: "Facial",
    category: "WELLNESS",
    image: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881",
  },
  {
    title: "Waxing",
    category: "FACE + BODY",
    image: "https://images.pexels.com/photos/6763618/pexels-photo-6763618.jpeg",
  },
  {
    title: "Men's waxing",
    category: "FACE + BODY",
    image:
      "https://hips.hearstapps.com/hmg-prod/images/mh-chest-wax-1533759591.png",
  },
  {
    title: "Men's facial",
    category: "WELLNESS",
    image:
      "https://blog.californiaskincaresupply.com/wp-content/uploads/2022/04/man-beard-get-facial-1024x684.jpg",
  },
  {
    title: "Intimate waxing",
    category: "HYGIENE",
    image: "https://images.pexels.com/photos/8528273/pexels-photo-8528273.jpeg",
  },
];
const women = [
  ["Signature haircut & finish", "$65+"],
  ["Blowout", "$45+"],
  ["Root refresh", "$75+"],
  ["Full colour", "$120+"],
  ["Balayage", "$180+"],
  ["Express facial", "$60+"],
  ["Manicure", "$30"],
  ["Event makeup", "$95+"],
];
const men = [
  ["Classic haircut", "$35"],
  ["Scissor cut", "$42"],
  ["Beard trim & shape", "$22"],
  ["Haircut + beard", "$52"],
  ["Grey blending", "$35+"],
  ["Scalp ritual", "$45"],
];
---

<BaseLayout
  title="The Wax House by Priya"
  description="Thoughtful skin and beauty rituals in a calm, welcoming space"
>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="#home" aria-label="The Wax House home">
        <span class="brand-mark">
          <img
            src={`${import.meta.env.BASE_URL}/logo.png`}
            alt="The Wax House"
            width="auto"
            height="60"
          />
        </span>
        <span class="brand-name">
          The Wax House <small>by Priya</small>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#intro">Our work</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact us</a>
      </nav>
      <button
        class="menu-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <a href={`${import.meta.env.BASE_URL}/womens-pricelist`}>
        Women's Pricelist
      </a>
      <a href={`${import.meta.env.BASE_URL}/mens-pricelist`}>Men's Pricelist</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div
        class="hero-image"
        role="img"
        aria-label="Sunlit beauty studio with soft natural textures"
      ></div>
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <div class="hero-kicker">
          <span class="tiny-star">
            <Icon name="asterisk" />
          </span>{" "}
          YOUR NEIGHBOURHOOD BEAUTY SALON
        </div>
        <h1>
          A little self-care
          <br />
          goes a <em>long way.</em>
        </h1>
        <div class="hero-actions">
          <a class="button" href="#contact">
            BOOK YOUR MOMENT{" "}
            <span>
              <Icon name="arrowRight" />
            </span>
          </a>
          <a class="text-link" href="#services">
            Explore our services{" "}
            <span>
              <Icon name="arrowDown" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="intro section-pad" id="intro">
      <div class="container intro-grid">
        <div class="intro-image-wrap">
          <img
            src="https://images.pexels.com/photos/9041612/pexels-photo-9041612.jpeg"
            alt="A stylist creating a thoughtful salon experience"
            loading="lazy"
          />
        </div>
        <div class="intro-copy">
          <span class="eyebrow">WELCOME TO THE WAX HOUSE</span>
          <h2 class="section-title">
            Beauty should feel
            <br />
            <em>like coming home.</em>
          </h2>
          <p>
            We believe the best appointments are about more than the mirror.
            They're a deep breath, a warm welcome, and a little space just for
            you.
          </p>
          <p>
            From your everyday hygiene to the occasion you've been looking
            forward to, we bring a thoughtful touch to every detail.
          </p>
          <a class="under-link" href="#services">
            GET TO KNOW OUR SERVICES{" "}
            <span>
              <Icon name="arrowDown" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="gallery-section section-pad" id="services">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">A LITTLE INSPIRATION</span>
            <h2 class="section-title">
              The art of <em>feeling good.</em>
            </h2>
          </div>
        </div>
        <div class="gallery-grid">
          {gallery.map((item, i) => (
            <article class={`gallery-card gallery-card-${i + 1}`}>
              <img src={item.image} alt={item.title} loading="lazy" />
              <div class="gallery-overlay">
                <span>{item.category}</span>
                <h3>{item.title}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="menu section-pad" id="menu">
      <div class="container">
        <div class="menu-heading">
          <span class="eyebrow">THE WAX HOUSE MENU</span>
          <h2 class="section-title">
            Your kind of <em>ritual.</em>
          </h2>
        </div>
        <div class="price-columns">
          <article class="price-card" id="women-prices">
            <div class="price-top">
              <span class="price-icon">
                <Icon name="asterisk" />
              </span>
              <span class="eyebrow">FOR HER</span>
              <h3>
                Women's
                <br />
                <em>pricelist</em>
              </h3>
              <p>Thoughtful treatments, tailored to you</p>
            </div>
            <a
              href={`${import.meta.env.BASE_URL}/womens-pricelist`}
              class="button button--outline price-button"
            >
              VIEW WOMEN'S MENU{" "}
              <span>
                <Icon name="arrowRight" />
              </span>
            </a>
          </article>
          <article class="price-card price-card-dark" id="men-prices">
            <div class="price-top">
              <span class="price-icon">
                <Icon name="asterisk" />
              </span>
              <span class="eyebrow">FOR HIM</span>
              <h3>
                Men's
                <br />
                <em>pricelist</em>
              </h3>
              <p>Good grooming, no fuss</p>
            </div>
            <a
              href={`${import.meta.env.BASE_URL}/mens-pricelist`}
              class="button price-button"
            >
              VIEW MEN'S MENU{" "}
              <span>
                <Icon name="arrowRight" />
              </span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="contact section-pad" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="eyebrow">YOUR CHAIR IS WAITING</span>
          <h2 class="section-title">
            Let's make time
            <br />
            for <em>you.</em>
          </h2>
          <div class="contact-details">
            <div>
              <span class="detail-icon">
                <Icon name="map" />
              </span>
              <p>
                <small>COME FIND US</small>
                <b>Room No. 3, 3469 Sheppard Ave E, Scarborough</b>
                <span>
                  Mon–Sat: 10:30 AM – 8 PM &ensp; | &ensp; Sun: 11 AM – 2 PM
                </span>
              </p>
            </div>
            <div>
              <span class="detail-icon">
                <Icon name="phone" />
              </span>
              <p>
                <small>GIVE US A RING</small>
                <b>+1 (437) 771-2802</b>
                <span>Or text us to find a time</span>
              </p>
            </div>
            <div>
              <span class="detail-icon">
                <Icon name="email" />
              </span>
              <p>
                <small>DROP US A NOTE</small>
                <b>thewaxhousebypriya@gmail.com</b>
                <span>We usually reply within a day</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="closing-banner">
      <div class="closing-message">
        <span>TAKE A BREATH</span>
        <span class="closing-flower">
          <Icon name="asterisk" />
        </span>
        <span>YOU DESERVE THIS</span>
      </div>

      <div class="closing-socials">
        <a
          href="https://www.instagram.com/priya_waxing_threading/"
          target="_blank"
          aria-label="Visit us on Instagram"
          class="social-icon"
        >
          <Icon name="instagram" />
        </a>

        <a
          href="https://share.google/JUisi5eQ3ja0UxnFd"
          target="_blank"
          aria-label="Check us out on Google"
          class="social-icon"
        >
          <Icon name="google" />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu",
    );
    if (menu) menu.hidden = !open;
    document.body.classList.toggle("menu-open", open);
  });
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open navigation menu");
      document.body.classList.remove("menu-open");
    }),
  );
</script>

<style>
  .site-header {
    height: 82px;
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(248, 245, 239, 0.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(231, 226, 216, 0.7);
  }
  .nav-wrap {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .brand-mark {
    font: 500 35px/0.9 var(--serif);
    position: relative;
    color: var(--sage-dark);
  }
  .brand-mark span {
    font: 12px var(--sans);
    position: absolute;

    right: -8px;
    top: -4px;
  }
  .brand-name {
    font-size: 14px;
    letter-spacing: 0.19em;
    font-weight: 700;
    line-height: 1.35;
  }
  .brand-name small {
    display: block;
    font-size: 10px;
    letter-spacing: 0.22em;
    font-weight: 500;
    color: var(--muted);
  }
  .desktop-nav {
    display: flex;
    gap: 30px;
    margin-left: auto;
    margin-right: 32px;
  }
  .desktop-nav a,
  .nav-cta {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .desktop-nav a {
    color: #5e6058;
    transition: color 0.2s;
  }
  .desktop-nav a:hover {
    color: var(--sage-dark);
    transform: scale(1.05);
  }
  .nav-cta {
    border-bottom: 1px solid var(--sage-dark);
    padding: 9px 0;
  }
  .nav-cta span {
    margin-left: 8px;
  }
  .menu-toggle {
    display: none;
    border: 0;
    background: none;
    width: 40px;
    height: 40px;
    padding: 10px;
    cursor: pointer;
  }
  .menu-toggle span {
    height: 1px;
    background: var(--ink);
    display: block;
    margin: 6px 0;
    transition: transform 0.2s;
  }
  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .mobile-menu {
    position: absolute;
    top: 81px;
    left: 0;
    right: 0;
    background: var(--paper);
    padding: 12px 24px 24px;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 25px #3331;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    font: 24px var(--serif);
  }
  .mobile-menu a span {
    font: 15px var(--sans);
    color: var(--sage-dark);
  }
  .hero {
    min-height: min(790px, calc(100svh - 82px));
    height: 730px;
    max-height: 850px;
    position: relative;
    overflow: hidden;
    background: #b8b8a9;
    color: white;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background: url("https://images.unsplash.com/photo-1721394749120-9ecece150e64?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D")
      center 43% / cover;
    transform: scale(1.015);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(28, 33, 27, 0.72) 0%,
        rgba(31, 34, 28, 0.49) 42%,
        rgba(34, 36, 30, 0.08) 100%
      ),
      linear-gradient(0deg, rgba(20, 25, 20, 0.38), transparent 30%);
  }
  .hero-content {
    position: relative;
    padding-top: clamp(100px, 15vh, 175px);
    z-index: 1;
  }
  .hero-kicker {
    font-size: 10px;
    letter-spacing: 0.19em;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tiny-star {
    font-size: 18px;
    color: #e5d8c4;
  }
  .hero h1 {
    font: 400 clamp(4.2rem, 8vw, 7.6rem)/0.98 var(--serif);
    letter-spacing: -0.055em;
    margin: 25px 0;
  }
  .hero h1 em,
  .section-title em,
  .price-top h3 em {
    font-weight: 400;
    color: #e2d6c5;
  }
  .hero-content > p {
    font-size: 15px;
    line-height: 1.8;
    max-width: 390px;
    color: #f1eee8;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 27px;
    margin-top: 70px;
  }
  .hero-actions .button {
    background: #e8e0d4;
    color: #33382f;
    border-color: #e8e0d4;
  }
  .text-link {
    font-size: 11px;
    border-bottom: 1px solid #ffffff8c;
    padding: 10px 0;
  }
  .text-link span {
    margin-left: 8px;
  }
  .hero-note {
    position: absolute;
    top: 435px;
    left: calc(100% - 130px);
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    font-size: 8px;
    line-height: 1.7;
    letter-spacing: 0.15em;
    color: #f3eee4;
  }
  .note-line {
    height: 1px;
    width: 36px;
    background: #e5d8c4;
  }
  .hero-stamp {
    position: absolute;
    right: 8%;
    top: 28%;
    border: 1px solid #ffffff80;
    border-radius: 50%;
    width: 135px;
    height: 135px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    font-size: 9px;
    letter-spacing: 0.2em;
    line-height: 1.6;
    transform: rotate(10deg);
  }
  .hero-stamp b {
    font-size: 19px;
    font-weight: 400;
    margin-top: 4px;
    color: #e2d6c5;
  }
  .hero-bottom {
    position: absolute;
    bottom: 23px;
    left: 0;
    right: 0;
    width: min(1160px, calc(100% - 48px));
    margin: auto;
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    letter-spacing: 0.16em;
    color: #f4eee4;
  }
  .intro {
    background: var(--paper);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(50px, 9vw, 120px);
    align-items: center;
  }
  .intro-image-wrap {
    position: relative;
    padding: 0 30px 30px 0;
  }
  .intro-image-wrap:before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 72%;
    height: 74%;
    background: #e6e7dc;
  }
  .intro-image-wrap img {
    height: 520px;
    position: relative;
    z-index: 1;
  }
  .image-caption {
    position: absolute;
    z-index: 2;
    bottom: 12px;
    left: 20px;
    color: white;
    font: italic 17px var(--serif);
    text-shadow: 0 1px 10px #0008;
  }
  .intro-copy .section-title {
    margin: 18px 0 24px;
  }
  .intro-copy .section-title em {
    color: var(--sage-dark);
  }
  .intro-copy > p {
    max-width: 440px;
    color: var(--muted);
    font-size: 13px;
  }
  .under-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding-bottom: 8px;
    border-bottom: 1px solid #aeb2a4;
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .intro-signature {
    margin-top: 43px;
    font: italic 20px var(--serif);
    color: var(--sage-dark);
  }
  .intro-signature span {
    font: 18px var(--sans);
    margin-left: 9px;
  }
  .gallery-section {
    background: #eeeee7;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 42px;
  }
  .section-heading .section-title {
    margin-bottom: 0;
  }
  .section-title em {
    color: var(--sage-dark);
  }
  .section-heading .section-copy {
    max-width: 350px;
    font-size: 13px;
    padding-bottom: 6px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
  }
  .gallery-card {
    position: relative;
    overflow: hidden;
    background: #d5d6cb;
    min-width: 0;
  }
  .gallery-card-1,
  .gallery-card-4 {
    grid-column: span 5;
    height: 330px;
  }
  .gallery-card-2,
  .gallery-card-3 {
    grid-column: span 7;
    height: 330px;
  }
  .gallery-card-5 {
    grid-column: span 7;
    height: 300px;
  }
  .gallery-card-6 {
    grid-column: span 5;
    height: 300px;
  }
  .gallery-card img {
    height: 100%;
    transition: transform 0.6s;
    filter: saturate(0.82);
  }
  .gallery-card:hover img {
    transform: scale(1.04);
  }
  .gallery-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 22px;
    color: white;
    background: linear-gradient(0deg, #171b16b8, transparent 65%);
  }
  .gallery-overlay > span {
    font-size: 9px;
    letter-spacing: 0.18em;
  }
  .gallery-overlay h3 {
    font: 400 25px var(--serif);
    margin: 5px 0 0;
  }
  .gallery-overlay b {
    position: absolute;
    right: 22px;
    bottom: 24px;
    font-weight: 400;
    font-size: 20px;
  }
  .gallery-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 30px;
  }
  .gallery-foot > span {
    font-size: 8px;
    letter-spacing: 0.13em;
    color: var(--muted);
  }
  .gallery-foot .under-link {
    margin-top: 0;
  }
  .menu {
    background: var(--cream);
  }
  .menu-heading {
    text-align: center;
    display: flex;
    align-items: center;
    flex-direction: column;
    margin-bottom: 46px;
  }
  .menu-heading .section-copy {
    font-size: 13px;
  }
  .price-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    max-width: 970px;
    margin: auto;
  }
  .price-card {
    background: var(--paper);
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid var(--line);
  }
  .price-card-dark {
    background: #626d5b;
    color: #fffdf9;
    border-color: #626d5b;
  }
  .price-card-dark .eyebrow,
  .price-card-dark .price-note {
    color: #d8ddcf;
  }
  .price-top {
    position: relative;
    border-bottom: 1px solid var(--line);
    padding-bottom: 25px;
  }
  .price-card-dark .price-top {
    border-color: #ffffff35;
  }
  .price-icon {
    position: absolute;
    right: 0;
    top: 0;
    font-size: 22px;
    color: var(--sage);
  }
  .price-top .eyebrow {
    font-size: 9px;
  }
  .price-top h3 {
    font: 400 43px/1.08 var(--serif);
    letter-spacing: -0.025em;
    margin: 15px 0;
  }
  .price-top h3 em {
    color: var(--sage-dark);
  }
  .price-card-dark .price-top h3 em {
    color: #e0d7c8;
  }
  .price-top p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  .price-card-dark .price-top p {
    color: #e1e3db;
  }
  .price-list {
    padding-top: 10px;
  }
  .price-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
