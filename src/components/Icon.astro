---
import { icon } from "@fortawesome/fontawesome-svg-core";

import {
  faLocationDot,
  faPhone,
  faEnvelope,
  faArrowDown,
  faArrowRight,
  faAsterisk,
} from "@fortawesome/free-solid-svg-icons";

import { faInstagram, faGoogle } from "@fortawesome/free-brands-svg-icons";

const icons = {
  map: faLocationDot,
  phone: faPhone,
  email: faEnvelope,
  arrowDown: faArrowDown,
  arrowRight: faArrowRight,
  asterisk: faAsterisk,
  instagram: faInstagram,
  google: faGoogle,
};

const { name, class: className = "" } = Astro.props;

const selectedIcon = icons[name as keyof typeof icons];

if (!selectedIcon) {
  throw new Error(`Unknown icon: ${name}`);
}

const renderedIcon = icon(selectedIcon).html.join("");
---

<span class:list={["site-icon", className]} set:html={renderedIcon} />

<style>
  .site-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .site-icon :global(svg) {
    width: 1em;
    height: 1em;
  }
</style>
